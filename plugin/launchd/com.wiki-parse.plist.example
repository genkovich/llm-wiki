<!-- Substitute __PLUGIN_ROOT__ with your installed plugin path, then copy to ~/Library/LaunchAgents/com.wiki-parse.plist -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wiki-parse</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PLUGIN_ROOT__/scripts/cron-parse.sh</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/wiki-parse.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/wiki-parse.err.log</string>
</dict>
</plist>
